# Ride Together - Supabase Configuration
# Duplicate this file as .env.local and fill in your Supabase project credentials.
# You can find these in your Supabase Dashboard: Settings -> API

# Your Supabase Project URL (e.g. https://xyzcompany.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=

# Your Supabase Anon / Public API Key
NEXT_PUBLIC_SUPABASE_ANON_KEY=
